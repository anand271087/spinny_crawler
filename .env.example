# Spinny OEM Spare-Parts Crawler — environment-variable template
#
# Copy this file to .env at the repo root, fill in the actual values, and load:
#     cp .env.example .env
#     set -a; source .env; set +a
#
# .env is in .gitignore — never committed. Real credentials are supplied
# out-of-band by the project owner (Spinny).
#
# The 20 brands with public catalogs (Mobil, Exide, HELLA, Monroe, Technix,
# Gabriel, Zip, Lumax, Valeo, Uno Minda, Amaron, SF Sonic, Schaeffler, JK Tyre,
# Bosch, Autokoi, Spark Minda, ZF, TVS Girling, Maruti) need NO credentials.

# -- SNAP-ON EPC dealer credentials ----------------------------------------
# Used by spiders/snapon_rest.py (shared by Hyundai + Toyota).
HYUNDAI_USER=
HYUNDAI_PASS=
TOYOTA_USER=
TOYOTA_PASS=

# -- Tata eCats (ASP.NET dealer portal) ------------------------------------
TATA_USER=
TATA_PASS=

# -- Intelli Catalogue v11.0 dealer credentials ----------------------------
MAHINDRA_USER=
MAHINDRA_PASS=
MG_USER=
MG_PASS=

# -- Ford Microcat (Infomedia SuperService) --------------------------------
FORD_USER=
FORD_PASS=

# -- SMTP for alert delivery (optional; only if you want email alerts) ----
# Host + port go in config/alerts.yaml; only the password is here.
SMTP_PASSWORD=

# -- Crawler tuning knobs (optional; defaults shown) -----------------------
# Number of parallel brand workers
CRAWLER_MAX_WORKERS=4

# SNAP-ON year scope (1 = year=2026 only, recommended)
HYUNDAI_MAX_YEARS=1
TOYOTA_MAX_YEARS=1

# ZF concurrency + cache. Full guide in docs/per_site_notes.md §20.
#
# ZF_USE_CACHE=0  → FULL DISCOVERY (~3.5h, ~30K API calls). Use:
#                   - on the very first run (no cache exists yet), AND
#                   - every 3 months (Jan/Apr/Jul/Oct) for a refresh.
#                   Always writes a fresh zf_hit_cache.json at end of run.
#
# ZF_USE_CACHE=1  → CACHED RUN (~15 min, ~960 API calls). Use:
#                   - for normal monthly cron runs in the 8 months between
#                     quarterly refreshes (no new parts will be missed
#                     unless ZF added them to a previously-empty tuple).
ZF_CONCURRENCY=3
ZF_USE_CACHE=0
